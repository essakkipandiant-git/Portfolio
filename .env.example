# Cloudinary CDN Base URL for Certificates (for Vercel deployment)
# Upload your 8 certificate images to a folder named "certificates" in Cloudinary Media Library,
# then set this variable in Vercel: Settings -> Environment Variables
#
# Format:
# VITE_CERTS_BASE_URL=https://res.cloudinary.com/<your-cloud-name>/image/upload/certificates
VITE_CERTS_BASE_URL=
